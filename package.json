{
  "name": "openchamber-github-task-board",
  "version": "1.1.0",
  "type": "module",
  "description": "Live Linear / Trello style Kanban board for GitHub Issues with attached OpenChamber sessions and git worktrees",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Workflows-Accelerator/openchamber-github-task-board.git"
  },
  "bugs": {
    "url": "https://github.com/Workflows-Accelerator/openchamber-github-task-board/issues"
  },
  "homepage": "https://github.com/Workflows-Accelerator/openchamber-github-task-board#readme",
  "scripts": {
    "build": "esbuild panel/main.ts --bundle --format=iife --target=chrome100 --tree-shaking=false --outfile=panel/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.22.0"
    },
    "capabilities": [
      "sessions",
      "prompt",
      "files",
      "filesystem"
    ],
    "contributes": {
      "panel": {
        "id": "github-task-board",
        "name": "Task Board",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "page": true,
      "attach": true,
      "filesystem": [
        "/workspace/**"
      ],
      "integration": {
        "name": "GitHub",
        "description": "Syncs tasks, checklists, and discussions with GitHub Issues",
        "token": {
          "apiOrigin": "https://api.github.com",
          "scheme": "bearer",
          "account": {
            "path": "/user",
            "name": "login"
          }
        },
        "settings": [
          {
            "id": "repo",
            "label": "Repository (owner/repo)"
          }
        ]
      }
    }
  }
}
