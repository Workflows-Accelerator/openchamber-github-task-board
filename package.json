{
  "name": "openchamber-github-task-board",
  "version": "1.2.2",
  "type": "module",
  "description": "Live Linear / Trello style Kanban board for GitHub Issues with attached OpenChamber sessions and git worktrees",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Workflows-Accelerator/openchamber-github-task-board.git"
  },
  "bugs": {
    "url": "https://github.com/Workflows-Accelerator/openchamber-github-task-board/issues"
  },
  "homepage": "https://github.com/Workflows-Accelerator/openchamber-github-task-board#readme",
  "scripts": {
    "build:panel": "esbuild panel/main.ts --bundle --format=iife --target=chrome100 --tree-shaking=false --outfile=panel/main.js",
    "build:service": "esbuild service/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=service/main.js",
    "build": "npm run build:panel && npm run build:service",
    "start:web": "node web/dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.1"
    },
    "contributes": {
      "capabilities": [
        "sessions",
        "prompt",
        "files"
      ],
      "panel": {
        "id": "github-task-board",
        "name": "Task Board",
        "icon": "list-check-2",
        "entry": "panel/index.html",
        "mobile": true
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "keepRunning": true
      },
      "statusSection": {
        "source": {
          "path": "/status",
          "interval": 5000
        },
        "title": "Task Board",
        "requiresProject": true,
        "defaultExpanded": true
      },
      "marks": true,
      "sessionControl": {},
      "sessionEvents": {
        "events": [
          "turn-started",
          "turn-finished",
          "turn-failed",
          "permission-asked",
          "question-asked",
          "session-archived",
          "session-deleted"
        ]
      },
      "instructions": true,
      "skills": "skills",
      "page": true,
      "attach": true,
      "filesystem": [
        "/workspace/**"
      ],
      "origins": [
        "https://api.github.com"
      ],
      "integration": {
        "name": "GitHub",
        "description": "Syncs tasks, checklists, and discussions with GitHub Issues",
        "token": {
          "apiOrigin": "https://api.github.com",
          "scheme": "bearer",
          "account": {
            "path": "/user",
            "name": "login"
          }
        },
        "settings": [
          {
            "id": "repo",
            "label": "Repository (owner/repo)"
          }
        ]
      }
    }
  }
}
