diff --git a/web/tests/last-correction.test.mjs b/web/tests/last-correction.test.mjs
new file mode 100644
index 0000000..24b08e7
--- /dev/null
+++ b/web/tests/last-correction.test.mjs
@@ -0,0 +1,147 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import { buildIssueDetail } from '../server/board.ts';
+import { makeIssue } from './fake-github.mjs';
+
+const source = readFileSync('web/public/app.js', 'utf8').replace(
+  '  boot();',
+  '  window.__app = { state, renderDetail, saveOverview, saveAnswer, saveStatus };',
+);
+const detail = () => buildIssueDetail(makeIssue({
+  number: 1,
+  body: '## Overview\nOriginal\n\n## Open Questions\n- [x] Done? *(Answer: yes)*\n- [ ] Current?\n\n## Human Tasks\n- [ ] Keep\n',
+  labels: ['status:todo', 'phase:execution', 'attention:needs-decision'],
+}));
+const options = [{ value: 'status:todo', label: 'Todo' }, { value: 'status:in-review', label: 'In review' }];
+const issueField = (key, value) => (payload) => { payload.issue[key] = value; };
+const missing = (key) => (payload) => { delete payload.issue[key]; };
+const invalidDetails = [
+  ['null option', (p) => { p.statusOptions = [null]; }],
+  ['partial option', (p) => { p.statusOptions = [{}]; }],
+  ['non-string option value', (p) => { p.statusOptions[0].value = {}; }],
+  ['non-string option label', (p) => { p.statusOptions[0].label = null; }],
+  ['missing top-level options despite nested fallback', (p) => { p.issue.statusOptions = p.statusOptions; delete p.statusOptions; }],
+  ['null section', issueField('editableSections', [null])],
+  ['partial section', issueField('editableSections', [{}])],
+  ...['id', 'title', 'text'].flatMap((key) => [
+    [`missing section ${key}`, (p) => { delete p.issue.editableSections[0][key]; }],
+    [`non-string section ${key}`, (p) => { p.issue.editableSections[0][key] = {}; }],
+  ]),
+  ['null question', issueField('openQuestions', [null])],
+  ['scalar question', issueField('openQuestions', [42])],
+  ['partial question', issueField('openQuestions', [{}])],
+  ...['index', 'answerIndex', 'text', 'completed'].map((key) => [
+    `missing question ${key}`, (p) => { delete p.issue.openQuestions[1][key]; },
+  ]),
+  ['non-string question text', (p) => { p.issue.openQuestions[1].text = {}; }],
+  ['non-boolean question completed', (p) => { p.issue.openQuestions[1].completed = 'false'; }],
+  ['fractional answer index', (p) => { p.issue.openQuestions[1].answerIndex = 0.5; }],
+  ['negative answer index', (p) => { p.issue.openQuestions[1].answerIndex = -1; }],
+  ['string answer index', (p) => { p.issue.openQuestions[1].answerIndex = '0'; }],
+  ['misrouted answer index', (p) => { p.issue.openQuestions[1].answerIndex = 1; }],
+  ['completed answer index', (p) => { p.issue.openQuestions[0].answerIndex = 0; }],
+  ['unresolved null index', (p) => { p.issue.openQuestions[1].answerIndex = null; }],
+  ['wrong source index', (p) => { p.issue.openQuestions[1].index = 0; }],
+  ...['humanTasks', 'acceptanceCriteria', 'subtasks'].flatMap((key) => [
+    [`null ${key} entry`, issueField(key, [null])],
+    [`partial ${key} entry`, issueField(key, [{}])],
+    [`non-string ${key} text`, issueField(key, [{ text: {}, completed: false }])],
+    [`non-boolean ${key} completed`, issueField(key, [{ text: '', completed: 'false' }])],
+  ]),
+  ['wrong identity', issueField('number', 2)],
+  ['missing fingerprint', missing('fingerprint')],
+  ['empty fingerprint', issueField('fingerprint', '')],
+  ['missing title', missing('title')],
+  ['non-string title', issueField('title', {})],
+  ['missing state', missing('state')],
+  ['invalid state', issueField('state', 'gateway')],
+  ...['statusLabel', 'updatedAt', 'phase', 'attention'].flatMap((key) => [
+    [`missing ${key}`, missing(key)],
+    [`wrong ${key}`, issueField(key, {})],
+  ]),
+];
+
+function browser(payload) {
+  const elements = new Map();
+  function node(tag = 'div') {
+    let text = '';
+    return {
+      tagName: tag, children: [], value: '', hidden: false, disabled: false,
+      get textContent() { return text; },
+      set textContent(value) { text = value; this.children = []; },
+      setAttribute(key, value) { this[key] = value; if (key === 'id') elements.set(value, this); },
+      removeAttribute(key) { delete this[key]; },
+      appendChild(child) { this.children.push(child); },
+      addEventListener() {}, focus() {},
+    };
+  }
+  const get = (id) => {
+    if (!elements.has(id)) elements.set(id, node());
+    return elements.get(id);
+  };
+  const calls = [];
+  const context = vm.createContext({
+    document: { getElementById: get, createElement: node },
+    window: { setTimeout: (fn) => fn(), setInterval() {}, addEventListener() {}, location: { hash: '' } },
+    fetch: async (path, request) => {
+      calls.push({ path, request });
+      return { ok: true, status: 200, text: async () => JSON.stringify(payload) };
+    },
+  });
+  vm.runInContext(source, context);
+  const app = context.window.__app;
+  app.state.detail = detail();
+  app.state.statusOptions = structuredClone(options);
+  app.renderDetail(false);
+  get('overview-text').value = 'Typed overview draft';
+  get('answer-0').value = 'Typed answer draft';
+  get('status-select').value = 'status:in-review';
+  return { app, get, calls };
+}
+
+for (const kind of ['section', 'question', 'status']) {
+  for (const [name, damage] of invalidDetails) {
+    test(`R1 ${kind}: ${name} is UNKNOWN before assignment and preserves both drafts`, async () => {
+      const payload = { issue: detail(), statusOptions: structuredClone(options) };
+      damage(payload);
+      const { app, get, calls } = browser(payload);
+      const before = app.state.detail;
+      const statusBefore = app.state.statusOptions;
+      const questionNodes = get('question-list').children;
+      const humanNodes = get('human-list').children;
+      if (kind === 'section') await app.saveOverview();
+      else if (kind === 'question') await app.saveAnswer(0, get('answer-0'));
+      else await app.saveStatus();
+      assert.equal(app.state.detail, before, 'last valid detail retained');
+      assert.equal(app.state.statusOptions, statusBefore, 'last valid options retained');
+      assert.equal(get('overview-text').value, 'Typed overview draft');
+      assert.equal(get('answer-0').value, 'Typed answer draft');
+      assert.equal(get('question-list').children, questionNodes, 'question DOM untouched');
+      assert.equal(get('human-list').children, humanNodes, 'human task DOM untouched');
+      const feedback = get(kind === 'section' ? 'save-status' : 'notice').textContent;
+      assert.match(feedback, /outcome unknown/i);
+      assert.match(feedback, /refresh/i);
+      assert.equal(calls.length, 1, 'one request, no repeat');
+    });
+  }
+  for (const empty of [false, true]) {
+    test(`R1 ${kind}: valid ${empty ? 'null/empty' : 'populated'} detail succeeds`, async () => {
+      const issue = detail();
+      if (empty) Object.assign(issue, {
+        title: '', statusLabel: null, updatedAt: null, phase: '', attention: '',
+        editableSections: [], openQuestions: [], humanTasks: [], acceptanceCriteria: [], subtasks: [],
+      });
+      const payload = { issue, statusOptions: empty ? [] : options };
+      const { app, get, calls } = browser(payload);
+      if (kind === 'section') await app.saveOverview();
+      else if (kind === 'question') await app.saveAnswer(0, get('answer-0'));
+      else await app.saveStatus();
+      assert.equal(app.state.detail.fingerprint, issue.fingerprint);
+      assert.equal(app.state.detail.title, issue.title);
+      assert.equal(get('announcer').textContent, kind === 'section' ? 'Overview saved.' : kind === 'question' ? 'Answer saved.' : 'Status updated.');
+      assert.equal(calls.length, 1);
+    });
+  }
+}
diff --git a/web/tests/mixed-indent.test.mjs b/web/tests/mixed-indent.test.mjs
new file mode 100644
index 0000000..2955814
--- /dev/null
+++ b/web/tests/mixed-indent.test.mjs
@@ -0,0 +1,61 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { applyQuestionAnswer, buildBoardList, buildIssueDetail } from '../server/board.ts';
+import { HttpSession, startBoard } from './helpers.mjs';
+import { makeIssue, startFakeGitHub } from './fake-github.mjs';
+
+for (const spaces of [1, 2, 3]) {
+  const indent = ' '.repeat(spaces) + '\t';
+  test(`R3: ${spaces} spaces plus tab is code in scanner, list and detail`, () => {
+    const raw = makeIssue({ number: 1, body: `## Open Questions\n\n${indent}- [ ] Code?\n` });
+    assert.deepEqual(buildBoardList([raw]).issues[0].counts.openQuestions, { total: 0, done: 0, open: 0 });
+    assert.deepEqual(buildIssueDetail(raw).openQuestions, []);
+  });
+  test(`R3: ${spaces} spaces plus tab direct code target refuses before PATCH`, async () => {
+    const body = `## Open Questions\r\n\r\n${indent}- [ ] Code?\r\n`;
+    const raw = makeIssue({ number: 1, body });
+    assert.throws(() => applyQuestionAnswer(raw, 0, 'must refuse'), /no longer answerable/);
+    const fake = await startFakeGitHub({ issues: [raw] });
+    const board = await startBoard(fake);
+    try {
+      const client = new HttpSession(board.url);
+      assert.equal((await client.login()).status, 200);
+      const detail = await client.request('/api/issues/1');
+      const response = await client.request('/api/issues/1/questions/0/answer', {
+        method: 'POST', body: { answer: 'must refuse', fingerprint: detail.json.issue.fingerprint },
+      });
+      assert.equal(response.status, 400);
+      assert.equal(response.json.error, 'invalid_edit');
+      assert.equal(fake.patchCalls.length, 0);
+      assert.equal(fake.findIssue(1).body, body);
+    } finally {
+      await board.app.close();
+      await fake.close();
+    }
+  });
+  test(`R3: ${spaces} spaces plus tab stays byte-exact around real nested questions and CRLF`, async () => {
+    const body = `## Open Questions\r\n- [x] Done? *(Answer: yes)*\r\n- [ ] First?\r\n\r\n${indent}- [ ] Code?\r\n\r\n  - [ ] Nested real?\r\n    continuation\r\n- [ ] Last?\r\n`;
+    const expected = body.replace('  - [ ] Nested real?', '  - [x] Nested real? *(Answer: exact)*');
+    const raw = makeIssue({ number: 1, body });
+    assert.deepEqual(buildIssueDetail(raw).openQuestions.map((q) => [q.text, q.answerIndex]), [
+      ['Done? *(Answer: yes)*', null], ['First?', 0], ['Nested real?', 1], ['Last?', 2],
+    ]);
+    assert.equal(applyQuestionAnswer(raw, 1, 'exact'), expected);
+    const fake = await startFakeGitHub({ issues: [raw] });
+    const board = await startBoard(fake);
+    try {
+      const client = new HttpSession(board.url);
+      assert.equal((await client.login()).status, 200);
+      const detail = await client.request('/api/issues/1');
+      const response = await client.request('/api/issues/1/questions/1/answer', {
+        method: 'POST', body: { answer: 'exact', fingerprint: detail.json.issue.fingerprint },
+      });
+      assert.equal(response.status, 200);
+      assert.equal(fake.patchCalls.length, 1);
+      assert.equal(fake.findIssue(1).body, expected);
+    } finally {
+      await board.app.close();
+      await fake.close();
+    }
+  });
+}
diff --git a/web/tests/validation-provenance.test.mjs b/web/tests/validation-provenance.test.mjs
new file mode 100644
index 0000000..a847c18
--- /dev/null
+++ b/web/tests/validation-provenance.test.mjs
@@ -0,0 +1,89 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { GitHubClient, GitHubError } from '../server/github.ts';
+import { HttpSession, startBoard } from './helpers.mjs';
+import { makeIssue, startFakeGitHub } from './fake-github.mjs';
+
+const validationError = { resource: 'Issue', field: 'body', code: 'invalid' };
+const cases = [
+  ['empty gateway errors', { message: 'Gateway lost upstream', errors: [] }],
+  ['gateway string errors', { message: 'Gateway lost upstream', errors: ['connection reset'] }],
+  ['gateway validation substring', { message: 'Gateway validation failed while relaying committed response' }],
+  ['gateway with shaped errors', { message: 'Gateway lost upstream', errors: [validationError] }],
+  ['exact message alone', { message: 'Validation Failed' }],
+  ['exact message empty errors', { message: 'Validation Failed', errors: [] }],
+  ['exact message scalar errors', { message: 'Validation Failed', errors: ['connection reset'] }],
+  ['exact message null entry', { message: 'Validation Failed', errors: [null] }],
+  ['exact message partial entry', { message: 'Validation Failed', errors: [{}] }],
+  ['exact message missing resource', { message: 'Validation Failed', errors: [{ field: 'body', code: 'invalid' }] }],
+  ['exact message wrong field', { message: 'Validation Failed', errors: [{ ...validationError, field: {} }] }],
+  ['exact message empty resource', { message: 'Validation Failed', errors: [{ ...validationError, resource: '' }] }],
+  ['exact message transport code', { message: 'Validation Failed', errors: [{ ...validationError, code: 'connection reset' }] }],
+  ['exact message mixed errors', { message: 'Validation Failed', errors: [validationError, 'connection reset'] }],
+  ['recognisable validation', { message: 'Validation Failed', errors: [validationError] }, true],
+];
+
+for (const kind of ['section', 'question', 'status']) {
+  for (const [name, payload, definitive = false] of cases) {
+    test(`R2 ${kind}: ${name} is ${definitive ? 'definitive rejection' : 'UNKNOWN after commit'}`, async () => {
+      const originalBody = '## Overview\nOriginal\n\n## Open Questions\n- [ ] Question?\n';
+      const fake = await startFakeGitHub({ issues: [makeIssue({ number: 1, body: originalBody, labels: ['status:todo'] })] });
+      const board = await startBoard(fake);
+      try {
+        const client = new HttpSession(board.url);
+        assert.equal((await client.login()).status, 200);
+        const detail = await client.request('/api/issues/1');
+        fake.setPatchHook((issue, patch, request, response) => {
+          if (!definitive) {
+            if (patch.body !== undefined) issue.body = patch.body;
+            if (patch.labels !== undefined) issue.labels = patch.labels.map((name) => ({ name }));
+          }
+          response.writeHead(422, { 'content-type': 'application/json' });
+          response.end(JSON.stringify(payload));
+        });
+        const route = kind === 'section' ? '/section' : kind === 'question' ? '/questions/0/answer' : '/status';
+        const response = await client.request('/api/issues/1' + route, {
+          method: kind === 'section' ? 'PUT' : 'POST',
+          body: { fingerprint: detail.json.issue.fingerprint, sectionId: 'overview', text: 'Committed', answer: 'Committed', status: 'status:in-review' },
+        });
+        assert.equal(response.status, definitive ? 400 : 502);
+        assert.equal(response.json.error, definitive ? 'invalid_request' : 'write_outcome_unknown');
+        assert.equal(fake.patchCalls.length, 1, 'one dispatched PATCH, no repeat');
+        const current = fake.findIssue(1);
+        const committed = kind === 'status' ? current.labels.some((label) => label.name === 'status:in-review') : current.body.includes('Committed');
+        assert.equal(committed, !definitive);
+        if (definitive) assert.equal(current.body, originalBody);
+      } finally {
+        await board.app.close();
+        await fake.close();
+      }
+    });
+  }
+}
+
+test('R2: reads keep exact validation-message mapping without inferring a write outcome', async () => {
+  for (const message of ['Validation Failed', 'Validation failed']) {
+    const client = new GitHubClient({
+      apiBase: 'http://127.0.0.1:1', token: 'synthetic', repo: { owner: 'owner', name: 'repo', full: 'owner/repo' },
+      fetchImpl: async () => new Response(JSON.stringify({ message }), { status: 422 }),
+    });
+    await assert.rejects(client.getIssue(1), (error) => error instanceof GitHubError && error.kind === 'invalid');
+  }
+});
+
+test('R2: GitHubError retains parsed response provenance for UNKNOWN and validation', async () => {
+  for (const [name, data, definitive = false] of cases) {
+    const client = new GitHubClient({
+      apiBase: 'http://127.0.0.1:1', token: 'synthetic', repo: { owner: 'owner', name: 'repo', full: 'owner/repo' },
+      fetchImpl: async () => new Response(JSON.stringify(data), { status: 422 }),
+    });
+    await assert.rejects(client.updateIssue(1, { body: 'test' }), (error) => {
+      assert.ok(error instanceof GitHubError, name);
+      assert.equal(error.status, 422, name);
+      assert.equal(error.jsonParsed, true, name);
+      assert.deepEqual(error.data, data, name);
+      assert.equal(error.kind, definitive ? 'invalid' : 'server', name);
+      return true;
+    });
+  }
+});
