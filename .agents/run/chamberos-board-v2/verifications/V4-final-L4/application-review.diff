+
+/* Workflows Board: shared modal geometry and task-workspace rhythm. */
+body.sheet-open { overflow: hidden; }
+.board-sheet {
+  position: fixed; inset: 16px 16px 16px auto; margin: 0;
+  width: min(480px, calc(100vw - 32px)); min-width: 0; max-width: calc(100vw - 32px);
+  height: fit-content; max-height: calc(100dvh - 32px); padding: 0;
+  display: flex; flex-direction: column; overflow: hidden;
+  background: var(--surf); color: var(--fg); border: 1px solid var(--border-strong);
+  border-radius: 16px; box-shadow: 0 24px 80px rgba(0, 0, 0, .28);
+  transform: none; font-size: 14px; text-align: left;
+}
+.board-sheet::backdrop { background: rgba(0, 0, 0, .72); }
+.board-sheet[open] { animation: sheet-enter 160ms ease-out; }
+@keyframes sheet-enter { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
+.sheet-handle { display: none; flex: 0 0 auto; width: 40px; height: 4px; margin: 12px auto 0; border-radius: 2px; background: var(--fg-faint); }
+.sheet-head { display: flex; align-items: center; justify-content: space-between; flex: 0 0 auto; gap: 16px; min-height: 76px; padding: 12px 20px; border-bottom: 1px solid var(--border); background: var(--surf); }
+.sheet-head h2, .sheet-head .sheet-title { margin: 0; white-space: normal; min-height: 44px; display: flex; align-items: center; font-size: 20px; line-height: 1.2; font-weight: 650; letter-spacing: -.02em; }
+.sheet-head .button { min-width: 44px; min-height: 44px; flex: 0 0 auto; font-size: 24px; }
+.sheet-content { flex: 1 1 auto; min-height: 0; overflow: auto; overscroll-behavior: contain; padding: 20px; scrollbar-gutter: stable; }
+.sheet-content > :first-child { margin-top: 0; }
+.sheet-content > :last-child { margin-bottom: 0; }
+.sheet-content h3 { margin: 24px 0 8px; font-size: 16px; }
+.sheet-content p { max-width: 65ch; line-height: 1.5; }
+.sheet-intro { margin: 0 0 24px; }
+.sheet-group { min-width: 0; margin: 0 0 24px; border: 0; padding: 0; }
+.sheet-group:last-child { margin-bottom: 0; }
